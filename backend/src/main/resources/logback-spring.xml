<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <springProfile name="observability">
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <labels>app=boardly-backend
level=%level</labels>
            <structuredMetadata>trace_id=%X{traceId}
span_id=%X{spanId}</structuredMetadata>
            <message>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            </message>
            <http>
                <url>\${LOKI_URL:-http://localhost:3100/loki/api/v1/push}</url>
                <requestTimeoutMs>3000</requestTimeoutMs>
                <maxRetries>1</maxRetries>
            </http>
            <batch><maxItems>200</maxItems><timeoutMs>3000</timeoutMs></batch>
        </appender>
        <root level="INFO"><appender-ref ref="CONSOLE"/><appender-ref ref="LOKI"/></root>
    </springProfile>
    <springProfile name="!observability">
        <root level="INFO"><appender-ref ref="CONSOLE"/></root>
    </springProfile>
</configuration>
